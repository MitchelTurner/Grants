NODE_ENV=development
APP_URL=http://localhost:3000
# Railway sets PORT. Local default is 3000.
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/segrants
REDIS_URL=redis://localhost:6379
# openssl rand -base64 32
SESSION_SECRET=
CSRF_SECRET=
LOG_LEVEL=info

S3_ENDPOINT=                # Cloudflare R2 endpoint
S3_REGION=auto
S3_BUCKET=
S3_BACKUP_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

POSTMARK_SERVER_TOKEN=
POSTMARK_BROADCAST_STREAM=digest
EMAIL_FROM="Southeast Grants <hello@example.org>"

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=         # or TWILIO_MESSAGING_SERVICE_SID
TWILIO_MESSAGING_SERVICE_SID=

ANTHROPIC_API_KEY=          # Phase 2
AI_MODEL_DEFAULT=claude-sonnet-5-5

STRIPE_SECRET_KEY=          # Phase 3
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=           # Stripe Price id for Pro. Leave blank until pricing is set.

SENTRY_DSN=
# Public DSN for the browser app. Often the same value as SENTRY_DSN.
VITE_SENTRY_DSN=
